{
  "folders": [
    {
      "name": "BeamRT Live Mod",
      "path": "."
    }
  ],
  "settings": {
    "files.autoSave": "off",
    "files.exclude": {
      ".beamrt-validation": true,
      "**/__pycache__": true
    },
    "search.exclude": {
      ".beamrt-validation/**": true,
      "**/__pycache__/**": true,
      "**/*.bin": true
    },
    "terminal.integrated.profiles.windows": {
      "BeamRT PowerShell 7": {
        "path": "C:/Users/ab/.cache/codex-runtimes/codex-primary-runtime/dependencies/native/powershell/pwsh.exe",
        "args": ["-NoLogo"]
      }
    },
    "terminal.integrated.defaultProfile.windows": "BeamRT PowerShell 7",
    "terminal.integrated.cwd": "${workspaceFolder}"
  },
  "extensions": {
    "recommendations": [
      "sumneko.lua",
      "ms-vscode.PowerShell"
    ]
  }
}
